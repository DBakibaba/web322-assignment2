<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Projects - Climate Solutions</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mx-auto my-10">
    <div class="hero bg-base-200 p-8 rounded-lg shadow-lg mb-10 text-center">
      <h1 class="text-4xl font-bold mb-4">Climate Solution Projects</h1>
      <div class="flex flex-wrap justify-center gap-3 mb-4">
        <a href="/solutions/projects?sector=Agriculture" class="btn btn-outline">Agriculture</a>
        <a href="/solutions/projects?sector=Energy" class="btn btn-outline">Energy</a>
        <a href="/solutions/projects?sector=Transportation" class="btn btn-outline">Transportation</a>
        <a href="/solutions/projects?sector=Industry" class="btn btn-outline">Industry</a>
        <a href="/solutions/projects?sector=Land Sinks" class="btn btn-outline">Land Sinks</a>
    </div>
</div>
<% if (session.user) { %>
  <a href="/solutions/addProject" class="btn btn-success mt-4">Add New Project</a>
<% } %>
    <div class="overflow-x-auto">
  <table class="table table-zebra w-full">
     
    <thead>
      <tr>
        <th>Title</th>
        <th>Sector</th>
        <th>Summary</th>
        <th>Action</th>
      </tr>
    </thead>
     
    <tbody>
      <% projects.forEach(project => { %>
        <tr>
          <td><%= project.title %></td>
          <td>
            <a href="/solutions/projects?sector=<%= project.Sector.sector_name %>" class="btn btn-sm btn-outline">
              <%= project.Sector.sector_name %>
            </a>
          </td>
          <td><%= project.summary_short %></td>
          <td>
            <a href="/solutions/projects/<%= project.id %>" class="btn btn-sm btn-primary">
              Details
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>


</body>
</html>
